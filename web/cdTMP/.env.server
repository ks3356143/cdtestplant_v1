# 子路径部署（云服务器 nginx 挂在 /cdtestplant/ 下）
# 构建命令：npm run build:server
VITE_APP_ENV = production
# 静态资源与路由前缀（vite base），必须与 nginx location 一致，且以 / 结尾
VITE_APP_BASE = /cdtestplant/
# 接口基址：用相对路径，避免把 127.0.0.1 写进前端产物
VITE_APP_BASE_URL = /cdtestplant/api
# 非 axios 场景（下载/上传 action）使用的接口前缀
VITE_APP_PROXY_PREFIX = /cdtestplant/api
# 附件/图片直链前缀（后端 uploads 由 nginx 反代）
VITE_APP_STORAGE_URL = /cdtestplant
VITE_APP_WS_URL = /cdtestplant/message.io
