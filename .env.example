# 环境配置样例
# 复制为 .env 后填入真实值；.env 含凭据，不纳入版本库

# ---- LDAP 认证 ----
AUTH_LDAP_SERVER_URI=
AUTH_LDAP_SERVER_URI_IP=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
BASE_DN=
FILTER_STR=

# ---- 应用密钥（GB/T 28452-2012 7.1.10：密钥不写死在源码里）----
# 留空则使用源码内置的开发缺省值；生产环境请填入随机生成的长字符串。
# 变更后已签发的令牌会失效（需重新登录），不影响业务数据。
DJANGO_SECRET_KEY=

# ---- 用户敏感字段（电话/邮箱）落库加密密钥（GB/T 28452-2012 7.1.8）----
# 留空则由 DJANGO_SECRET_KEY 派生。**一旦变更，历史密文将无法解密**，务必先备份。
FIELD_ENCRYPTION_KEY=

# ---- 主机头白名单（GB/T 28452-2012 7.1.10）----
# 逗号分隔；留空为通配 *（便于部署，但放宽了主机头校验），生产环境应收敛为实际入口
ALLOWED_HOSTS=

# ---- 数据库连接（GB/T 28452-2012 7.1.8 保密性 / 7.1.10 最小授权）----
# 生产环境应使用只对本库授权、非 root 的应用账号，口令为强口令
DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
